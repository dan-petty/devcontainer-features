{
    "rootless_vscode_keepid": {
        "image": "debian:sid",
        "containerUser": "root",
        "remoteUser": "vscode",
        "features": {
            "ghcr.io/devcontainers/features/common-utils:2": {
                "username": "vscode",
                "installZsh": false,
                "installOhMyZsh": false,
                "upgradePackages": false
            },
            "podman-in-podman": {}
        }
    },
    "rootful_limits": {
        "image": "debian:sid",
