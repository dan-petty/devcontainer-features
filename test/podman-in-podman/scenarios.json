                "username": "vscode",
                "installZsh": false,
                "installOhMyZsh": false,
                "upgradePackages": false
            },
            "podman-in-podman": {}
        }
    },
    "build": {
        "image": "debian:sid",
        "remoteUser": "vscode",
        "features": {
            "ghcr.io/devcontainers/features/common-utils:2": {
                "username": "vscode",
                "installZsh": false,
                "installOhMyZsh": false,
                "upgradePackages": false
            },
            "podman-in-podman": {}
        }
