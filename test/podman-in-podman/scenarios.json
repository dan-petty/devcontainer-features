    "docker_compat": {
        "image": "debian:sid",
        "remoteUser": "vscode",
        "features": {
            "ghcr.io/devcontainers/features/common-utils:2": {
                "username": "vscode",
                "installZsh": false,
                "installOhMyZsh": false,
                "upgradePackages": false
            },
            "podman-in-podman": {
                "dockerCompat": true
            }
        }
    },
    "minimal": {
        "image": "debian:sid",
        "features": {
            "podman-in-podman": {
                "buildah": false,
                "skopeo": false,
                "compose": "none"
            }
        }
    },
    "with_docker_in_docker": {
        "build": {
            "dockerfile": "Dockerfile",
            "args": {
                "BASE_IMAGE": "debian:sid"
            }
        },
        "remoteUser": "vscode",
        "features": {
            "ghcr.io/devcontainers/features/common-utils:2": {
                "username": "vscode",
                "installZsh": false,
                "installOhMyZsh": false,
                "upgradePackages": false
            },
            "ghcr.io/devcontainers/features/docker-in-docker:4": {
                "moby": false
            },
            "podman-in-podman": {
                "dockerCompat": true
            }
        }
    },
    "subid_ranges": {
        "image": "debian:sid",
        "features": {
            "podman-in-podman": {}
        }
    },
    "idempotent": {
        "image": "debian:sid",
        "remoteUser": "vscode",
